# Copy to .env for local runs outside Docker (the Makefile reads it if present).
RPI_DATABASE_URL=postgresql://rpi:rpi@localhost:5432/rpi
RPI_LANDING_DIR=data/landing
RPI_TRUTH_DIR=data/truth
RPI_REPORTS_DIR=data/reports
# Optional: protect the review-decision endpoint of the API.
# Write endpoints are disabled unless a key of at least 16 characters is set.
#   openssl rand -hex 24
# RPI_API_KEY=
